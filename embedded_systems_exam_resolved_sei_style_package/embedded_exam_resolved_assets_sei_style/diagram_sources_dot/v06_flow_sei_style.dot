digraph G {
graph [rankdir=TB, bgcolor="white", labelloc="t", label="Varianta 6 - schemă bloc funcțională / flux program", fontsize=18, fontname="DejaVu Sans", splines=ortho, nodesep=0.45, ranksep=0.55];
node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded", penwidth=1.2, margin="0.10,0.07"];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7, penwidth=1.1];
S [label="Start", shape=oval, style=""];
I [label="Init serial, LCD, driver motor", shape=box, style="rounded"];
RX [label="dacă există comandă: citește TH_ON/TH_OFF", shape=parallelogram, style=""];
V [label="citește valoare controlată", shape=box, style="rounded"];
D1 [label="motor OFF și valoare < TH_ON?", shape=diamond, style=""];
ON [label="pornește motor", shape=box, style="rounded"];
D2 [label="motor ON și valoare > TH_OFF?", shape=diamond, style=""];
OFF [label="oprește motor", shape=box, style="rounded"];
L [label="LCD: praguri + stare motor", shape=box, style="rounded"];
T [label="delay dT", shape=box, style="rounded"];
S -> I [label=""];
I -> RX [label=""];
RX -> V [label=""];
V -> D1 [label=""];
D1 -> ON [label="DA"];
D1 -> D2 [label="NU"];
ON -> L [label=""];
D2 -> OFF [label="DA"];
D2 -> L [label="NU"];
OFF -> L [label=""];
L -> T [label=""];
T -> RX [label=""];
}