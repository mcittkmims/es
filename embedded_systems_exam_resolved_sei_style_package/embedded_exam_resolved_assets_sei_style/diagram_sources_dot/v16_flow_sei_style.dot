ERR [label="eroare = setpoint - viteză", shape=box, style="rounded"];
PID [label="calculează PID
P + I + D, anti-windup", shape=box, style="rounded"];
SAT [label="limitează PWM 0..100%", shape=box, style="rounded"];
M [label="aplică PWM la driver motor", shape=box, style="rounded"];
L [label="LCD: viteză, setpoint, PWM", shape=box, style="rounded"];
T [label="delay dT constant", shape=box, style="rounded"];
S -> I [label=""];
I -> RX [label=""];
RX -> E [label=""];
