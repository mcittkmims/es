digraph v15_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 15 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	M1 [label="MCU1
generator mesaj"]
	UART [label="UART serial
TX/RX/GND"]
	M2 [label="MCU2
parser + CRC"]
	LCD [label=LCD]
	P [label=Alimentare]
	P -> M1 [label="" fontsize=9]
	P -> M2 [label="" fontsize=9]
	M1 -> UART [label=TX fontsize=9]
	UART -> M2 [label=RX fontsize=9]
	M2 -> LCD [label="I2C/GPIO" fontsize=9]
}
