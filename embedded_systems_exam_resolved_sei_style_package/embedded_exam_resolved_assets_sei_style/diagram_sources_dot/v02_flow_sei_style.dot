digraph G {
graph [rankdir=TB, bgcolor="white", labelloc="t", label="Varianta 2 - schemă bloc funcțională / flux program", fontsize=18, fontname="DejaVu Sans", splines=ortho, nodesep=0.45, ranksep=0.55];
node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded", penwidth=1.2, margin="0.10,0.07"];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7, penwidth=1.1];
S [label="Start", shape=oval, style=""];
I [label="Init I2C master/slave, senzor, LCD", shape=box, style="rounded"];
A [label="MCU1: citește senzor umiditate", shape=box, style="rounded"];
P [label="CMD + DATA + CRC", shape=box, style="rounded"];
T [label="transmite pe magistrala I2C", shape=box, style="rounded"];
R [label="MCU2: recepție I2C", shape=box, style="rounded"];
V [label="CRC valid?", shape=diamond, style=""];
E [label="afișează ERR pe LCD", shape=box, style="rounded"];
L [label="afișează valoare pe LCD", shape=box, style="rounded"];
D [label="delay / următorul ciclu", shape=box, style="rounded"];
S -> I [label=""];
I -> A [label=""];
A -> P [label=""];
P -> T [label=""];
T -> R [label=""];
R -> V [label=""];
V -> E [label="NU"];
E -> R [label=""];
V -> L [label="DA"];
L -> D [label=""];
D -> A [label=""];
}