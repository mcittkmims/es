digraph v08_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 8 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	TEMP [label="Senzor temperatură motor"]
	POT [label="Potențiometru
prag critic"]
	MCU [label="MCU
