digraph G {
graph [rankdir=LR, bgcolor="white", labelloc="t", label="Varianta 12 - schemă bloc funcțională / flux program", fontsize=18, fontname="DejaVu Sans", splines=ortho, nodesep=0.45, ranksep=0.55];
node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded", penwidth=1.2, margin="0.10,0.07"];
edge [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7, penwidth=1.1];
S [label="Start", shape=oval, style=""];
I [label="Init HW + creare taskuri FreeRTOS", shape=box, style="rounded"];
RTOS [label="vTaskStartScheduler()", shape=box, style="rounded"];
TS [label="Task achiziție
periodic: citește senzor", shape=box, style="rounded"];
Q [label="Queue / variabilă protejată", shape=cylinder, style=""];
TL [label="Task LCD
primește valoare și afișează", shape=box, style="rounded"];
TT [label="Task Serial
raportează stare", shape=box, style="rounded"];
S -> I [label=""];
I -> RTOS [label=""];
RTOS -> TS [label=""];
TS -> Q [label="send"];
Q -> TL [label="receive"];
Q -> TT [label="receive"];
TL -> TS [label="delay"];
TT -> TS [label="delay"];
}