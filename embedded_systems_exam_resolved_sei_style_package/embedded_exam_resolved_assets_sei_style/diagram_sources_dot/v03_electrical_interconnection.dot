digraph v03_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 3 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	POT [label="Potențiometru
setare prag"]
	MCU [label="MCU
