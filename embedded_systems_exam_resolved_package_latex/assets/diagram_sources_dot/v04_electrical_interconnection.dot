digraph v04_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 4 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	BTN [label="Buton mod
auto/manual"]
	MCU [label="MCU
Timer + FSM"]
