digraph v12_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 12 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	S [label=Senzor]
	MCU [label="MCU + FreeRTOS
3 taskuri"]
	LCD [label=LCD]
	UART [label="Serial terminal"]
	P [label=Alimentare]
