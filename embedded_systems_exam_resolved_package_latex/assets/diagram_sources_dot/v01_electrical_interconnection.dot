digraph v01_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 1 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	S [label="Senzor temperatură
analog/digital"]
	M1 [label="MCU1
achiziție + TX"]
	U [label="UART
TX/RX + GND"]
	M2 [label="MCU2
RX + CRC"]
	LCD [label="LCD
I2C/GPIO"]
	P [label="Alimentare 5V/3.3V
GND comun"]
	P -> M1 [label="Vcc/GND" fontsize=9]
	P -> M2 [label="Vcc/GND" fontsize=9]
	S -> M1 [label="ADC/I2C" fontsize=9]
	M1 -> U [label=TX fontsize=9]
	U -> M2 [label=RX fontsize=9]
	M2 -> LCD [label="SDA/SCL sau GPIO" fontsize=9]
}
