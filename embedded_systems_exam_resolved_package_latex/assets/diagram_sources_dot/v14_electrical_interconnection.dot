digraph v14_electrical_interconnection {
	fontsize=16 labelloc=t rankdir=LR
	label="Variant 14 - diagramă conceptuală de interconectare electrică"
	node [fontsize=10 shape=box]
	S [label="Senzor temperatură"]
	M1 [label="MCU1
I2C master"]
	BUS [label="I2C bus
SDA/SCL + pull-up"]
	M2 [label="MCU2
I2C slave"]
	LCD [label=LCD]
	P [label="Alimentare
GND comun"]
	P -> M1 [label="" fontsize=9]
	P -> M2 [label="" fontsize=9]
	S -> M1 [label="ADC/I2C local" fontsize=9]
	M1 -> BUS [label="SDA/SCL" fontsize=9]
	BUS -> M2 [label="addr slave" fontsize=9]
	M2 -> LCD [label="I2C/GPIO" fontsize=9]
}
